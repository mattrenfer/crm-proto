# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Get these from: Supabase Dashboard > Project Settings > API
#
# Use the anon (publishable) key ONLY. NEXT_PUBLIC_* values are copied into the browser bundle,
# so anyone can read them. Never put the service role / secret key here: it bypasses
# Row Level Security. src/lib/env.ts refuses to start if it detects one.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Demo account, for the "Look around with the demo account" button.
# No NEXT_PUBLIC_ prefix: these stay on the server and never reach the browser.
# Optional locally. Without them, the button shows "unavailable".
DEMO_EMAIL=demo@matthewrenfer.com
DEMO_PASSWORD=your_demo_password

# Server only. Used by the demo route alone, to sign in to the demo account without a CAPTCHA token.
# It bypasses Row Level Security, so never give it a NEXT_PUBLIC_ prefix and never commit it.
# Supabase Dashboard > Project Settings > API Keys > Legacy API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare Turnstile (CAPTCHA) site key. Public by design. The secret key goes only into
# Supabase > Authentication > Bot and Abuse Protection, never here.
# For local work against a project using Cloudflare's test secret, use the test site key
# 1x00000000000000000000BB (always passes, invisible).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
