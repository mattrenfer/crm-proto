# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Get these from: Supabase Dashboard > Project Settings > API
#
# Use the anon (publishable) key ONLY. NEXT_PUBLIC_* values are copied into the browser bundle,
# so anyone can read them. Never put the service role / secret key here: it bypasses
# Row Level Security. src/lib/env.ts refuses to start if it detects one.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
